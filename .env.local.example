NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test-mode keys, used for the $0.50 parental-consent card
# authorization (immediately voided, never captured).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. New-message and matching-roster-post notifications are
# best-effort without it — the app works fine, emails just don't send.
RESEND_API_KEY=
